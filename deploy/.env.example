# 生产域名与 ACME 联系邮箱。域名必须已解析到部署服务器。
DOMAIN=vault.example.com
ACME_EMAIL=ops@example.com

# MySQL 专用数据库和账号。请使用随机高熵值，不能复用开发环境口令。
MYSQL_DATABASE=online_safe
MYSQL_USER=online_safe
MYSQL_PASSWORD=请替换为随机数据库口令
MYSQL_ROOT_PASSWORD=请替换为随机数据库根口令

# 使用 32 字节随机值的 Base64 编码；该密钥不得变更，否则历史邀请码无法解密。
INVITATION_ENCRYPTION_KEY=请替换为32字节随机密钥的Base64编码

# 保险箱服务端加密密钥（32 字节 Base64）；变更后旧密文无法解密。
VAULT_ENCRYPTION_KEY=请替换为32字节随机密钥的Base64编码
VAULT_CURRENT_KEY_ID=1

# 阿里云短信（注册 / 重置密码验证码）。模板变量约定为 code。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_REGISTER=
ALIYUN_SMS_TEMPLATE_RESET=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_LENGTH=6
SMS_SEND_INTERVAL_SECONDS=60
SMS_SEND_DAILY_LIMIT=10
# 可选：本地未配密钥时可设 SMS_PROVIDER=logging；生产必须为 aliyun
# SMS_PROVIDER=aliyun

# 腾讯云 COS（个人中心头像；后端中转上传）。生产 COS_PROVIDER=tencent
COS_PROVIDER=tencent
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PREFIX=
COS_PATH_PREFIX=avatars
# 可选：自定义 CDN/域名；不填则用 bucket.cos.region.myqcloud.com
COS_PUBLIC_BASE_URL=
